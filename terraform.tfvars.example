# Copy this file to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored.

# Name of the cloud entry in ~/.config/openstack/clouds.yaml
openstack_cloud = "rumble"

# Compute
instance_name = "web-host"
image_name    = "Ubuntu 24.04 LTS"
flavor_name   = "s1a.small"
volume_size   = 40

# Networking — names vary by provider; check the Rumble/OpenStack dashboard
network_name          = "private"
external_network_name = "public"

# Your personal SSH public key (installed alongside the TF-managed key)
ssh_pubkey_path = "~/.ssh/id_rsa.pub"

# Optional: restrict SSH to your IP
# allowed_ssh_cidrs = ["203.0.113.42/32"]

# Reverse-proxy virtual hosts (optional)
# proxy_domains = [
#   { domain = "example.com",     upstream = "http://127.0.0.1:3000" },
#   { domain = "api.example.com", upstream = "http://127.0.0.1:8080" },
# ]
# certbot_email = "you@example.com"
