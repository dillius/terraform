# Copy this file to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored.

# Name of the cloud entry in ~/.config/openstack/clouds.yaml
openstack_cloud = "rumble"

# Compute — docker mem_limits assume ~4 GiB RAM (s1a.medium). Do not use
# s1a.small without shrinking limits in docker/docker-compose.yml.
instance_name = "web-host"
image_name    = "Ubuntu 24.04 LTS"
flavor_name   = "s1a.medium"
volume_size   = 40

# Networking — Rumble exposes two public networks:
#   PublicEphemeral — shared, DHCP-enabled, VMs attach directly. Address may
#                     change if the port is recreated. Best for single-VM setups.
#   PublicStatic   — external floating-IP pool. Needs a router with external
#                     gateway + a floating IP, which together consume 2 slots of
#                     the default `public_ip` quota of 1 — request a quota raise
#                     before using this pattern.
network_name = "PublicEphemeral"

# Your personal SSH public key (installed alongside the TF-managed key)
ssh_pubkey_path = "~/.ssh/id_ed25519.pub"

# Strongly recommended: restrict SSH and NPM admin (81) to your IP
# allowed_ssh_cidrs   = ["203.0.113.42/32"]
# allowed_admin_cidrs = ["203.0.113.42/32"]

# --- Host stack secrets (required; written to the instance .env on apply) ---
# Min 12 characters each. Stored in Terraform state — protect state like a secret.
postgres_password       = "replace-with-a-long-random-password"
grafana_admin_password  = "replace-with-a-long-random-password"
# ntfy.sh topic for Grafana alerts — use something long/random (unauthenticated)
ntfy_topic              = "replace-with-a-long-random-topic-name"

# Optional: bump to force host redeploy without changing docker/ files
# host_deploy_revision = "2"

# Install nginx + certbot from apt on first boot (default: false — use NPM in Docker)
# install_nginx = true

# Domains for Cloudflare DNS (and apt-nginx vhosts only if install_nginx = true).
# With NPM, configure proxy hosts in the NPM UI; upstream here is unused.
# proxy_domains = [
#   { domain = "example.com",     upstream = "http://127.0.0.1:3000" },
#   { domain = "api.example.com", upstream = "http://127.0.0.1:8080" },
# ]
# certbot_email = "you@example.com"   # required only with install_nginx = true

# GHCR credentials (optional) — docker login during host_config deploy
# github_username = "your-github-username"
# github_token    = "ghp_..."   # fine-grained PAT, read:packages only

# Cloudflare DNS (optional) — A records for each proxy_domains entry
#
# Token: dash.cloudflare.com/profile/api-tokens → "Edit zone DNS" template
# Zone ID: Cloudflare dashboard → domain → Overview → right-hand panel
#
# cloudflare_api_token = "..."
# cloudflare_proxied   = false   # flip true after origin certs work
# cloudflare_zone_id   = "abc123def456..."
#
# Or per-domain zones:
# proxy_domains = [
#   { domain = "example.com",    upstream = "http://127.0.0.1:3000", cf_zone_id = "abc123..." },
#   { domain = "other-site.com", upstream = "http://127.0.0.1:8080", cf_zone_id = "def456..." },
# ]
