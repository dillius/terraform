#cloud-config
# Bootstrap only — first boot. Day-2 host config (docker compose stack, GHCR
# login, secrets) is applied by null_resource.host_config in host.tf so it can
# re-run on tofu apply without replacing the instance.
package_update: true
package_upgrade: true

packages:
%{ if install_nginx ~}
  - nginx
  - certbot
  - python3-certbot-nginx
%{ endif ~}
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - fail2ban
  - unattended-upgrades

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      ChallengeResponseAuthentication no
      X11Forwarding no
      AllowAgentForwarding no
      MaxAuthTries 3
      LoginGraceTime 30

  - path: /etc/fail2ban/jail.d/sshd.local
    content: |
      [sshd]
      enabled = true
      port = ssh
      maxretry = 5
      bantime = 3600
      findtime = 600

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /etc/apt/apt.conf.d/50unattended-upgrades
    content: |
      Unattended-Upgrade::Allowed-Origins {
        "$${distro_id}:$${distro_codename}-security";
      };
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Automatic-Reboot "false";

%{ if install_nginx ~}
%{ for d in proxy_domains ~}
  - path: /etc/nginx/sites-available/${d.domain}
    content: |
      server {
          listen 80;
          listen [::]:80;
          server_name ${d.domain};

          location / {
              proxy_pass         ${d.upstream};
              proxy_http_version 1.1;
              proxy_set_header   Host              $$host;
              proxy_set_header   X-Real-IP         $$remote_addr;
              proxy_set_header   X-Forwarded-For   $$proxy_add_x_forwarded_for;
              proxy_set_header   X-Forwarded-Proto $$scheme;
              proxy_set_header   Upgrade           $$http_upgrade;
              proxy_set_header   Connection        "upgrade";
          }
      }

%{ endfor ~}
  - path: /usr/local/bin/setup-ssl
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
%{ if length(proxy_domains) == 0 ~}
      echo "No proxy_domains configured. Nothing to do." >&2
      exit 0
%{ else ~}
      EMAIL="${certbot_email}"
      if [ -z "$$EMAIL" ]; then
        echo "certbot_email is not set. Edit /usr/local/bin/setup-ssl and set EMAIL." >&2
        exit 1
      fi
%{ for d in proxy_domains ~}
      certbot --nginx --non-interactive --agree-tos -m "$$EMAIL" -d ${d.domain}
%{ endfor ~}
      systemctl reload nginx
      echo "SSL certificates issued and nginx reloaded."
%{ endif ~}
%{ endif ~}

runcmd:
  # Swap — cushions transient memory spikes without OOM-killing the host.
  # Not a substitute for sizing mem_limits and flavor RAM sanely.
  - fallocate -l 2G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - bash -c 'echo "/swapfile none swap sw 0 0" >> /etc/fstab'
  - sysctl -w vm.swappiness=10
  - bash -c 'echo "vm.swappiness=10" >> /etc/sysctl.conf'

  # Personal SSH key (OpenStack keypair is injected separately via key_pair)
  - mkdir -p /home/ubuntu/.ssh
  - bash -c 'echo "${user_pubkey}" >> /home/ubuntu/.ssh/authorized_keys'
  - chown -R ubuntu:ubuntu /home/ubuntu/.ssh
  - chmod 700 /home/ubuntu/.ssh
  - chmod 600 /home/ubuntu/.ssh/authorized_keys

  # Docker engine — stack deploy happens later via null_resource.host_config
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker ubuntu
  - systemctl enable --now docker

%{ if install_nginx ~}
  - rm -f /etc/nginx/sites-enabled/default
%{ for d in proxy_domains ~}
  - ln -sf /etc/nginx/sites-available/${d.domain} /etc/nginx/sites-enabled/${d.domain}
%{ endfor ~}
  - nginx -t
  - systemctl enable nginx
  - systemctl restart nginx
%{ endif ~}

  - systemctl enable --now fail2ban
  - systemctl restart sshd

  # Host firewall — defence in depth. Real IP restrictions for SSH/admin are
  # enforced by OpenStack security groups (allowed_ssh_cidrs / allowed_admin_cidrs).
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 81/tcp
  - ufw --force enable
