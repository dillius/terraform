# State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Plan output
*.tfplan

# Provider plugin cache (keep .terraform.lock.hcl committed)
.terraform/
.terraform.tfstate.lock.info

# Variable files that may hold secrets
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
!terraform.tfvars.example

# Local compose env (host gets .env from null_resource.host_config)
.env
docker/.env

# Generated SSH keys
.ssh/

# Editor swap/temp files
*.swp
*.swo
*~
