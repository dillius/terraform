apiVersion: 1

contactPoints:
  - orgId: 1
    name: ntfy
    receivers:
      - uid: ntfy-webhook
        type: webhook
        disableResolveMessage: false
        settings:
          # Topic is injected by null_resource.host_config from var.ntfy_topic.
          # ntfy.sh topics are unauthenticated by default — use a hard-to-guess name.
          url: https://ntfy.sh/${ntfy_topic}
          httpMethod: POST
          headers:
            Title: Grafana Alert
            Priority: urgent
            Tags: warning,rotating_light
          payload:
            template: |
              {{ range .Alerts }}[{{ .Status }}] {{ .Labels.alertname }} ({{ .Labels.instance }})
              {{ .Annotations.summary }}
              {{ end }}
